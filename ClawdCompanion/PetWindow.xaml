<Window x:Class="ClawdCompanion.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clawd"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        Width="392" Height="434"
        Left="-10000" Top="-10000">
    <Grid x:Name="Root">
        <!-- contact shadow, drawn behind Clawd -->
        <Canvas x:Name="ShadowLayer" IsHitTestVisible="False">
            <Ellipse x:Name="Shadow" Width="120" Height="18" Opacity="0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#66000000" Offset="0" />
                        <GradientStop Color="#33000000" Offset="0.55" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- Clawd -->
        <Viewport3D x:Name="View" ClipToBounds="False">
            <Viewport3D.Camera>
                <OrthographicCamera x:Name="Cam" Position="0,0,20" LookDirection="0,0,-1" UpDirection="0,1,0"
                                    Width="2.8" NearPlaneDistance="1" FarPlaneDistance="60" />
            </Viewport3D.Camera>
            <ModelVisual3D x:Name="LightsVisual" />
        </Viewport3D>

        <!-- particles, ring handle and the Codex-style pet tray -->
        <Canvas x:Name="Overlay">
            <Canvas x:Name="FxLayer" IsHitTestVisible="False" />

            <!-- nearly invisible hit area so the thin key ring is easy to hook -->
            <Ellipse x:Name="RingHandle" Width="50" Height="50" Fill="#01FFFFFF" Cursor="Hand"
                     ToolTip="Drag me by the ring"
                     MouseLeftButtonDown="RingHandle_MouseLeftButtonDown"
                     MouseLeftButtonUp="RingHandle_MouseLeftButtonUp"
                     LostMouseCapture="RingHandle_LostMouseCapture" />

            <Border x:Name="Pill" Height="30" CornerRadius="15" Padding="11,0,5,0" Visibility="Hidden"
                    Background="{StaticResource Codex.SurfaceBrush}" BorderBrush="{StaticResource Codex.RingBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.35" Color="#000000" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusHalo" Width="8" Height="8" Fill="#339CFF" Opacity="0.3" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="HaloScale" ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#339CFF" />
                    </Grid>
                    <TextBlock x:Name="StatusText" Margin="8,0,7,1" VerticalAlignment="Center" Text="Vibing"
                               FontFamily="{StaticResource Codex.UiFont}" FontSize="12.5"
                               Foreground="{StaticResource Codex.FgBrush}" />
                    <StackPanel x:Name="PillActions" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <Rectangle Width="1" Height="14" Margin="1,0,4,0" VerticalAlignment="Center" Fill="{StaticResource Codex.LineBrush}" />
                        <Button x:Name="BtnHi" Style="{StaticResource CodexIconButton}" Content="&#xE76E;" ToolTip="Say hi" Click="BtnHi_Click" />
                        <Button x:Name="BtnPet" Style="{StaticResource CodexIconButton}" Content="&#xEB51;" ToolTip="Pet Clawd" Click="BtnPet_Click" />
                        <Button x:Name="BtnNap" Style="{StaticResource CodexIconButton}" Content="&#xE708;" ToolTip="Nap time" Click="BtnNap_Click" />
                        <Button x:Name="BtnHop" Style="{StaticResource CodexIconButton}" Content="&#xE74A;" ToolTip="Hop" Click="BtnHop_Click" />
                        <Button x:Name="BtnMore" Style="{StaticResource CodexIconButton}" Content="&#xE712;" ToolTip="More" Click="BtnMore_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
