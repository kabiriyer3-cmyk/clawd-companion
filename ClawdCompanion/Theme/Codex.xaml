<!--
  Codex design tokens (dark), modelled on the OpenAI Codex desktop app:
  flat #181818 surfaces, a faint translucent-white ring instead of heavy borders,
  compact 26-30px controls, 12-13px UI text, subtle translucent hover fills,
  accent #339CFF and Codex's semantic greens/reds/purples.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fonts -->
    <FontFamily x:Key="Codex.UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Codex.MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Codex.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Colors -->
    <Color x:Key="Codex.Surface">#F0181818</Color>
    <Color x:Key="Codex.Elevated">#F7202020</Color>
    <Color x:Key="Codex.Ring">#28FFFFFF</Color>
    <Color x:Key="Codex.Line">#17FFFFFF</Color>
    <Color x:Key="Codex.Fg">#FFFFFFFF</Color>
    <Color x:Key="Codex.FgSecondary">#C7FFFFFF</Color>
    <Color x:Key="Codex.Muted">#7FFFFFFF</Color>
    <Color x:Key="Codex.Hover">#12FFFFFF</Color>
    <Color x:Key="Codex.Press">#1FFFFFFF</Color>
    <Color x:Key="Codex.Accent">#FF339CFF</Color>

    <SolidColorBrush x:Key="Codex.SurfaceBrush" Color="{StaticResource Codex.Surface}" />
    <SolidColorBrush x:Key="Codex.ElevatedBrush" Color="{StaticResource Codex.Elevated}" />
    <SolidColorBrush x:Key="Codex.RingBrush" Color="{StaticResource Codex.Ring}" />
    <SolidColorBrush x:Key="Codex.LineBrush" Color="{StaticResource Codex.Line}" />
    <SolidColorBrush x:Key="Codex.FgBrush" Color="{StaticResource Codex.Fg}" />
    <SolidColorBrush x:Key="Codex.FgSecondaryBrush" Color="{StaticResource Codex.FgSecondary}" />
    <SolidColorBrush x:Key="Codex.MutedBrush" Color="{StaticResource Codex.Muted}" />
    <SolidColorBrush x:Key="Codex.HoverBrush" Color="{StaticResource Codex.Hover}" />
    <SolidColorBrush x:Key="Codex.PressBrush" Color="{StaticResource Codex.Press}" />
    <SolidColorBrush x:Key="Codex.AccentBrush" Color="{StaticResource Codex.Accent}" />

    <!-- Round icon button used in the pet tray -->
    <Style x:Key="CodexIconButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Codex.FgSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Codex.IconFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="13">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Codex.HoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource Codex.FgBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Codex.PressBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Context menu -->
    <Style x:Key="CodexMenu" TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource Codex.FgBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Codex.UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="12" Background="{StaticResource Codex.ElevatedBrush}" BorderBrush="{StaticResource Codex.RingBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="0,5,0,5" MinWidth="214">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.42" Color="#000000" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CodexMenuItem" TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource Codex.FgBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Codex.UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Height="28" Margin="5,0,5,0" Padding="6,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Check" Grid.Column="0" Text="&#xE73E;" FontFamily="{StaticResource Codex.IconFont}" FontSize="11"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{StaticResource Codex.AccentBrush}" Visibility="Hidden" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="False" />
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0" FontSize="12"
                                       VerticalAlignment="Center" Foreground="{StaticResource Codex.MutedBrush}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Codex.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Codex.MutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CodexMenuHeader" TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border Padding="14,6,14,7">
                        <ContentPresenter ContentSource="Header" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CodexMenuSection" TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource Codex.MutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Codex.UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border Padding="14,6,14,3">
                        <ContentPresenter ContentSource="Header" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CodexSeparator" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="10,5,10,5" Background="{StaticResource Codex.LineBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tooltips -->
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource Codex.ElevatedBrush}" BorderBrush="{StaticResource Codex.RingBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="8,4,8,5">
                        <ContentPresenter TextElement.Foreground="{StaticResource Codex.FgBrush}" TextElement.FontSize="12"
                                          TextElement.FontFamily="{StaticResource Codex.UiFont}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
